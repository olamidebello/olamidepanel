[Unit]
Description=Activate verified paid OlamidePanel services
After=network.target mysql.service olamidepanel.service
[Service]
Type=oneshot
User=olamidepanel
Group=olamidepanel
ExecStart=/opt/olamidepanel/venv/bin/python /opt/olamidepanel/panel/fulfillment.py
Environment=PANEL_DB_CONFIG=/etc/olamidepanel/database.json
Environment=PANEL_DATA=/var/lib/olamidepanel
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/olamidepanel
TimeoutStartSec=120
