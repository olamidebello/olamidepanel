[Unit]
Description=OlamidePanel DNS-verified static website provisioning
After=network-online.target mysql.service nginx.service
[Service]
Type=oneshot
User=root
ExecStart=/opt/olamidepanel/venv/bin/python /opt/olamidepanel/repo/deploy/provision_websites.py
Environment=PANEL_DB_CONFIG=/etc/olamidepanel/database.json
UMask=0022
PrivateTmp=true
TimeoutStartSec=12min
