[Unit]
Description=OlamidePanel control plane
After=network.target
[Service]
User=olamidepanel
Group=olamidepanel
ExecStart=/opt/olamidepanel/venv/bin/python /opt/olamidepanel/panel/server.py
EnvironmentFile=-/etc/olamidepanel/runtime.env
Environment=PANEL_DB_CONFIG=/etc/olamidepanel/database.json
Environment=PANEL_DATA=/var/lib/olamidepanel
Environment=PANEL_SECURE_COOKIE=1
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/olamidepanel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=multi-user.target
