server {
    listen 80;
    server_name {{ domain }};
{% if edition_certificate.stat.exists %}
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name {{ domain }};
    ssl_certificate /etc/letsencrypt/live/{{ weather_certificate_name | default(domain) }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ weather_certificate_name | default(domain) }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:{{ edition_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
}
